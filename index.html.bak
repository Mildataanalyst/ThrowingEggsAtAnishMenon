<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover" />
  <meta name="theme-color" content="#050505" />
  <meta name="description" content="Throw eggs at Anish Menon — a three-level birthday game." />
  <meta property="og:title" content="Throw Eggs at Anish Menon" />
  <meta property="og:description" content="Three levels. One Anish. Several eggs." />
  <meta property="og:image" content="./public/og-preview.jpg" />
  <link rel="icon" href="./public/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="./public/manifest.webmanifest" />
  <link rel="stylesheet" href="./styles.css" />
  <title>Throw Eggs at Anish Menon</title>
</head>
<body>
  <main id="app" aria-label="Throw Eggs at Anish Menon">
    <canvas id="game" width="430" height="780" aria-label="Game canvas"></canvas>

    <section id="overlay" class="overlay visible" aria-live="polite">
      <div id="card" class="card"></div>
    </section>

    <button id="sound-toggle" class="sound-toggle" aria-label="Mute sound" title="Sound">♪</button>
    <div id="loading" class="loading">LOADING ANISH…</div>
    <div id="fatal" class="fatal" role="alert">
      <strong>ANISH FAILED TO LOAD.</strong>
      <span>Refresh the page and try again.</span>
    </div>
  </main>

  <script type="module" src="./src/game.js"></script>
</body>
</html>
